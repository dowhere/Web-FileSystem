# Copy this file to .env in the same directory, then edit as needed.

# Host address and port for the web UI.
# Use 127.0.0.1 when running behind a reverse proxy; 0.0.0.0 exposes the port.
WF_BIND=0.0.0.0
WF_PORT=5500

# Login account. When AUTH_PASSWORD is set, the server enforces it on every
# start (creating the account if needed) and resets that user's password.
# Leave it empty to keep the password stored in the data volume; the first
# start generates a random password and prints it once in the container logs.
AUTH_USER=admin
AUTH_PASSWORD=

# Local bucket name (the folder inside the data volume).
BUCKET=local

# Set to 1 to disable login completely. Only do this when WF_BIND=127.0.0.1
# or the container is reachable exclusively on a trusted network.
NO_AUTH=0

# Set to 1 only when the container sits behind a trusted reverse proxy that
# sets X-Forwarded-For; used for login rate limiting.
TRUST_PROXY=0
